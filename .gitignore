# ---- 凭据 / 运行状态（绝对不要提交）---------------------------------------
# data/ 里的 astudio2api-data.json 含账号 token、模型 Bearer 与 API 密钥，
# 泄漏等同于泄漏账号密码。
data/
astudio2api-data.json
*.tmp.json

# ---- 逆向分析产物 ----------------------------------------------------------
# 从 AStudio app.asar 解包出来的 148 MB 转储，仅作本地协议比对用，
# 既体积过大也涉及第三方版权，不入库。
extract/

# ---- 构建产物 --------------------------------------------------------------
astudio2api
astudio2api.exe
*.exe
/dist/
/out/

# ---- 编辑器 / 系统 ---------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# ---- 本地日志 --------------------------------------------------------------
*.log
